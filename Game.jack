
class Game {
   // velocidad del juego
   field int delay;
   // objetos
   field Player player;
   field Score score;
   field Meteorito meteorito1;
   field Meteorito meteorito2;
   field Meteorito meteorito3;
   field Meteorito meteorito4;
   field Meteorito meteorito5;
   // estados
   field char key;      
   field char last_key;
   field boolean first_jump;
   field boolean exit;
   field boolean reset;
   field boolean quit;
   // perfilado
   field int frames1;
   field int frameCounter;
   field Array info;
   // pinchos
   field int spikesX;

   constructor Game new(int d) {
      let delay = d;
      // inicializar objetos
      let player = Player.new(8, 128);
      let score = Score.new();
      // crea meteoritos con separaracion (no spawneat todos juntos) y diferentes sprites
      let meteorito1 = Meteorito.new(491, 100);
      let meteorito2 = Meteorito.new(400, 151);
      let meteorito3 = Meteorito.new(300, 80);
      let meteorito4 = Meteorito.new(200, 120);
      let meteorito5 = Meteorito.new(100, 170);
      let frameCounter = 0;
      let spikesX = 0;
      let info = Array.new(6);
      let info[0] = "ET:";
      let info[1] = " (";
      let info[2] = "ms)";
      let info[3] = "  ";
      let info[4] = "Use <> arrow keys to set game speed (delay per frame).";
      let info[5] = "                                                      ";
      return this;
   }

   method void dispose() {
      // objetos chao
      do player.dispose();
      do score.dispose();
      do meteorito1.dispose();
      do meteorito2.dispose();
      do meteorito3.dispose();
      do meteorito4.dispose();
      do meteorito5.dispose();
      do info.dispose();
      do Memory.deAlloc(this);
      return;
   }

   // input del teclado
   method void handle_input() {
      let key = Keyboard.keyPressed();
      //
      if (key = 81) { // Q
         let exit = true; 
         let quit = true;
      }
      if ((key = 82) & (~first_jump)) { // R
         let exit = true; 
         let reset = true;
      }
      if ((key = 32) & (~(last_key=32))) { // space
         do player.jump();
         if (first_jump) {
            // el primer click empieza el juego
            let first_jump = false;
            // clear a la pantalla
            do Screen.clearScreen();
            // pinchos arriba y abajo
            let spikesX = 0;
            do SpriteManager.draw_top_spikes(0);
            do SpriteManager.draw_bottom_spikes(0);
         }
      } else {
         // debug que sube o baja el tiempo entre las frames
         if (((key = 130) & (~(last_key=130))) & (delay > 0)) { let delay = delay - 1; }   // left arrow
         if ((key = 132) & (~(last_key=132))) { let delay = delay + 1; }   // right arrow
      }
      //
      let last_key = key;
      return;
   }


   // actualiza los objetos cada frame
   method void refresh() {
      var int playerY;
      var int playerBottom;
      // animacion del jugador
      do player.update();  
      // actualizar sprites cuando empieza
      if ((~first_jump)) { 
         // hacer clear a las areas de los pinchos antes de update
         do Screen.setColor(false);
         do Screen.drawRectangle(0, 0, 512, 11);
         do Screen.drawRectangle(0, 245, 512, 256);
         // actualiza los mteoritos
         let spikesX = spikesX - 2;
         // resetea los pinchos cada 16 pixeles
         if (spikesX < -16) {
            let spikesX = spikesX + 16;
         }
         // clear a las posiciones antes de actualizar
         do meteorito1.clear();
         do meteorito2.clear();
         do meteorito3.clear();
         do meteorito4.clear();
         do meteorito5.clear();
         // actualizar los meteoritos
         do meteorito1.update();
         do meteorito2.update();
         do meteorito3.update();
         do meteorito4.update();
         do meteorito5.update();
         // si el meteorito sale de la pantalla sube el puntaje
         if (meteorito1.justExited() = 2) {
            do score.increment();
         }
         if (meteorito2.justExited() = 2) {
            do score.increment();
         }
         if (meteorito3.justExited() = 2) {
            do score.increment();
         }
         if (meteorito4.justExited() = 2) {
            do score.increment();
         }
         if (meteorito5.justExited() = 2) {
            do score.increment();
         }
         // efecto scroll en pinchos
         do SpriteManager.draw_top_spikes(spikesX);
         do SpriteManager.draw_bottom_spikes(spikesX);
         // meteoritos en posiciones nuevas
         do meteorito1.draw();
         do meteorito2.draw();
         do meteorito3.draw();
         do meteorito4.draw();
         do meteorito5.draw();
         // frame  counter
         let frameCounter = frameCounter + 1;
         // ver si se choca con meteoritos
         if (meteorito1.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         if (meteorito2.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         if (meteorito3.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         if (meteorito4.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         if (meteorito5.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         // ver si se choca con pinchos arriba
         if (player.hitTop() < 10) {
            let exit = true;
         }
         // abajo
         let playerY = player.y();
         let playerBottom = player.hitBottom();
         if (~(playerBottom < 245)) {
            let exit = true;
         }
         // check secudario
         if (~(playerY < 245)) {
            let exit = true;
         }
         // check terciario
         if (playerY > 217) {
            let exit = true;
         }
         // ultimo check
         if (playerBottom > 225) {
            let exit = true;
         }
      }
      return;
   }

   // delay del clock
   method void render_vitals() {
         var int safeFrames1;
         var int safeDelay;
         let frames1 = frames1 + 1;
         // prevenir overflow
         if (frames1 > 30000) {
            let frames1 = 0;
         }
         // actualizar display cada 30 frames
         if ((frames1 & 31) = 0) {
            if (frames1 < 0) { 
               let frames1 = 0;
               if (first_jump) {do Output.moveCursor(21,0);} 
               else {do Output.moveCursor(22,0);}
               do Output.printString(info[5]);
            }
            do Output.moveCursor(22,0);
            if (first_jump) {
               do Output.printString(info[4]);
               do Output.moveCursor(21,0);
            }
            // valores en rangos seguros para prevenir errores
            if (frames1 < 0) {
               let safeFrames1 = 0;
            } else {
               if (frames1 > 32767) {
                  let safeFrames1 = 32767;
               } else {
                  let safeFrames1 = frames1;
               }
            }
            if (delay < 0) {
               let safeDelay = 0;
            } else {
               if (delay > 32767) {
                  let safeDelay = 32767;
               } else {
                  let safeDelay = delay;
               }
            }
            do Output.printString(info[0]);
            do Output.printInt(safeFrames1);
            do Output.printString(info[1]);
            do Output.printInt(safeDelay);
            do Output.printString(info[2]);
            do Output.printString(info[3]);
         }
      return;
   }

   // GAME OVER cuando se pierde
   method void drawGameOver() {
      var int startX;
      var int startY;
      var int letterWidth;
      var int letterHeight;
      var int textWidth;
      var int textHeight;
      var int centerX;
      var int centerY;
      var int finalScore;
      let letterWidth = 30;
      let letterHeight = 40;
      // ancho del texto
      let textWidth = 150;
      // alto del texto
      let textHeight = 95;
      // centrar horizontal
      let centerX = 181;
      // centrar vertical
      let centerY = 80;
      let startX = centerX;
      let startY = centerY;
      do Screen.setColor(true);
      
      // GAME
      // G
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY+15, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX+15, startY+20, startX+letterWidth-5, startY+25);
      
      // A 
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+18, startX+letterWidth, startY+23);
      
      // M 
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX+12, startY, startX+18, startY+20);
      do Screen.drawRectangle(startX+letterWidth-18, startY, startX+letterWidth-12, startY+20);
      
      // E 
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+17, startX+letterWidth-5, startY+22);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      
      // OVER
      let startX = centerX;
      let startY = startY + letterHeight + 15;
      
      // O
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      
      // V 
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight-10);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight-10);
      do Screen.drawRectangle(startX+12, startY+letterHeight-15, startX+18, startY+letterHeight);
      
      // E 
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+17, startX+letterWidth-5, startY+22);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      
      // R 
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+20);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+17, startX+letterWidth-5, startY+22);
      do Screen.drawRectangle(startX+letterWidth-8, startY+20, startX+letterWidth-3, startY+letterHeight);
      
      // mostrar el puntaje final
      let finalScore = score.value();
      do Output.moveCursor(17, 26);
      do Output.printString("Score: ");
      do Output.printInt(finalScore);
      
      return;
   }

   // controles del juego
   method boolean run() {
      // inicia variables
      let key = 0;
      let last_key = 0;
      let first_jump = true;
      let exit = false;
      let reset = false;
      let quit = false;
      let frames1 = 0;
      let frameCounter = 0;

      // mensaje inicial y pinchos al principio
      do SpriteManager.draw_top_spikes(0);
      do SpriteManager.draw_bottom_spikes(0);
      do Output.moveCursor(5, 10);
      do Output.printString("FLAPPY DINO");
      do Output.moveCursor(7, 10);
      do Output.printString("Press SPACE to start");

      // loop del juego
      while (~exit) {
         do handle_input();
         do refresh();
         let frames1 = frames1 + 1;
         if (frames1 > 30000) {
            let frames1 = 0;
         }
         do Sys.wait(delay);
      }
      if ((~quit)) { // GAME OVER si si hace quit
         do Screen.clearScreen();
         do drawGameOver();
      }
      while ((~reset)) {
         let key = Keyboard.keyPressed();
         if (key = 81) { // Q to quit
            return false;
         }
         if (key = 82) { // R to reset
            let reset = true;
         }
      } 
      do reset();  
      return true;
   }

   // reciclar objetos al reiniciar
   method void reset() {
      do Screen.clearScreen();
      // resetear pinchos
      let spikesX = 0;
      // pinchos arriba y abajo
      do SpriteManager.draw_top_spikes(0);
      do SpriteManager.draw_bottom_spikes(0);
      do player.reset(8, 128);
      do score.reset();
      // resetea los meteoritos
      do meteorito1.reset(491, 100);
      do meteorito2.reset(400, 151);
      do meteorito3.reset(300, 80);
      do meteorito4.reset(200, 120);
      do meteorito5.reset(100, 170);
      return;
   }
}
