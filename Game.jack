
class Game {
   // game speed (throttling)
   field int delay;
   // objects
   field Player player;
   field Score score;
   field Meteorito meteorito1;
   field Meteorito meteorito2;
   field Meteorito meteorito3;
   // internal states
   field char key;      
   field char last_key;
   field boolean first_jump;
   field boolean exit;
   field boolean reset;
   field boolean quit;
   // profiling
   field int frames1;
   field int frameCounter;
   field Array info;

   constructor Game new(int d) {
      let delay = d;
      // initialize (allocate) objects
      let player = Player.new(8, 128);
      let score = Score.new();
      // create meteoritos starting from the right side of the screen
      // Position them with large spacing so they appear independently, not in groups
      // Max xPos is 499 (since width=12, 499+12=511 is the screen limit)
      let meteorito1 = Meteorito.new(499, 100);
      let meteorito2 = Meteorito.new(300, 150);
      let meteorito3 = Meteorito.new(100, 80);
      let frameCounter = 0;
      let info = Array.new(6);
      let info[0] = "ET:";
      let info[1] = " (";
      let info[2] = "ms)";
      let info[3] = "  ";
      let info[4] = "Use <> arrow keys to set game speed (delay per frame).";
      let info[5] = "                                                      ";
      return this;
   }

   method void dispose() {
      // dispose of (deallocate) objects
      do player.dispose();
      do score.dispose();
      do meteorito1.dispose();
      do meteorito2.dispose();
      do meteorito3.dispose();
      do info.dispose();
      do Memory.deAlloc(this);
      return;
   }

   // handle game logic (keyboard input)
   method void handle_input() {
      let key = Keyboard.keyPressed();
      //
      if (key = 81) { // Q
         let exit = true; 
         let quit = true;
      }
      if ((key = 82) & (~first_jump)) { // R
         let exit = true; 
         let reset = true;
      }
      if ((key = 32) & (~(last_key=32))) { // space
         do player.jump();
         if (first_jump) {
            // first jump (spacebar click) starts the game
            let first_jump = false;
            // clear screen to start playing
            do Screen.clearScreen();
         }
      } else {
         // debug controls: (decrease or increase the time between frames)
         if (((key = 130) & (~(last_key=130))) & (delay > 0)) { let delay = delay - 1; }   // left arrow
         if ((key = 132) & (~(last_key=132))) { let delay = delay + 1; }   // right arrow
      }
      //
      let last_key = key;
      return;
   }


   // update all active objects every frame
   method void refresh() {
      // update player animation
      do player.update();  
      // update the game sprites if started
      if ((~first_jump)) { 
         // clear previous positions before updating
         do meteorito1.clear();
         do meteorito2.clear();
         do meteorito3.clear();
         // update meteorito positions (move from right to left)
         do meteorito1.update();
         do meteorito2.update();
         do meteorito3.update();
         // draw meteoritos at new positions
         do meteorito1.draw();
         do meteorito2.draw();
         do meteorito3.draw();
         // redraw score counter only every 10 frames to reduce memory usage
         let frameCounter = frameCounter + 1;
         if ((frameCounter & 15) = 0) {
            do score.show();
         }
         // check collisions with meteoritos
         if (meteorito1.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         if (meteorito2.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         if (meteorito3.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
      }
      return;
   }

   // "clock (delay)" printer (profiling tool)
   method void render_vitals() {
         var int safeFrames1;
         var int safeDelay;
         let frames1 = frames1 + 1;
         // Prevent overflow: reset if frames1 becomes too large or negative
         // Max safe value for 16-bit signed int is 32767, reset before reaching it
         if (frames1 > 30000) {
            let frames1 = 0;
         }
         // Only update display every 30 frames to reduce memory usage
         if ((frames1 & 31) = 0) {
            if (frames1 < 0) { 
               let frames1 = 0;
               if (first_jump) {do Output.moveCursor(21,0);} 
               else {do Output.moveCursor(22,0);}
               do Output.printString(info[5]);
            }
            do Output.moveCursor(22,0);
            if (first_jump) {
               do Output.printString(info[4]);
               do Output.moveCursor(21,0);
            }
            // Ensure values are within safe range to prevent ERR6e errors
            if (frames1 < 0) {
               let safeFrames1 = 0;
            } else {
               if (frames1 > 32767) {
                  let safeFrames1 = 32767;
               } else {
                  let safeFrames1 = frames1;
               }
            }
            if (delay < 0) {
               let safeDelay = 0;
            } else {
               if (delay > 32767) {
                  let safeDelay = 32767;
               } else {
                  let safeDelay = delay;
               }
            }
            do Output.printString(info[0]);
            do Output.printInt(safeFrames1);
            do Output.printString(info[1]);
            do Output.printInt(safeDelay);
            do Output.printString(info[2]);
            do Output.printString(info[3]);
         }
      return;
   }

   // Draw large "GAME OVER" text centered on screen
   method void drawGameOver() {
      var int startX;
      var int startY;
      var int letterWidth;
      var int letterHeight;
      var int textWidth;
      var int textHeight;
      var int centerX;
      var int centerY;
      let letterWidth = 30;
      let letterHeight = 40;
      // Calculate text width: 4 letters * 30 + 3 spaces * 10 = 150
      let textWidth = 150;
      // Calculate text height: 40 (line1) + 15 (spacing) + 40 (line2) = 95
      let textHeight = 95;
      // Center horizontally: (512 - 150) / 2 = 181
      let centerX = 181;
      // Center vertically: (256 - 95) / 2 = 80
      let centerY = 80;
      let startX = centerX;
      let startY = centerY;
      do Screen.setColor(true);
      
      // Draw "GAME" - first line
      // G
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY+15, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX+15, startY+20, startX+letterWidth-5, startY+25);
      
      // A (after G, with spacing)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+18, startX+letterWidth, startY+23);
      
      // M (after A)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX+12, startY, startX+18, startY+20);
      do Screen.drawRectangle(startX+letterWidth-18, startY, startX+letterWidth-12, startY+20);
      
      // E (after M)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+17, startX+letterWidth-5, startY+22);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      
      // Draw "OVER" - second line (centered)
      let startX = centerX;
      let startY = startY + letterHeight + 15;
      
      // O
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      
      // V (after O)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight-10);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight-10);
      do Screen.drawRectangle(startX+12, startY+letterHeight-15, startX+18, startY+letterHeight);
      
      // E (after V)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+17, startX+letterWidth-5, startY+22);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      
      // R (after E)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+20);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+17, startX+letterWidth-5, startY+22);
      do Screen.drawRectangle(startX+letterWidth-8, startY+20, startX+letterWidth-3, startY+letterHeight);
      
      return;
   }

   // the main game control
   method boolean run() {
      // init all variables
      let key = 0;
      let last_key = 0;
      let first_jump = true;
      let exit = false;
      let reset = false;
      let quit = false;
      let frames1 = 0;
      let frameCounter = 0;

      // draw the introductory messages (text-only, to keep SpriteManager small)
      do Screen.clearScreen();
      do Output.moveCursor(5, 10);
      do Output.printString("FLAPPY DINO");
      do Output.moveCursor(7, 10);
      do Output.printString("Press SPACE to start");

      // enter the play loop
      while (~exit) {
         // game logic and render
         do handle_input();
         do refresh();
         // handle profiling, clock and delays
         do render_vitals();
         do Sys.wait(delay);
      }
      if ((~quit)) { // write "Game Over" if allowed to restart (not quitting)
         // Clear screen and draw large centered "GAME OVER"
         do Screen.clearScreen();
         do drawGameOver();
      }
      // wait to confirm reset, or to quit
      while ((~reset)) {
         let key = Keyboard.keyPressed();
         if (key = 81) { // Q to quit
            return false;
         }
         if (key = 82) { // R to reset
            let reset = true;
         }
      } 
      do reset();  
      return true;
   }

   // recycle already allocated objects upon restart
   method void reset() {
      do Screen.clearScreen();
      do player.reset(8, 128);
      do score.reset();
      // reset meteoritos to their initial positions (right side of screen, spaced apart)
      do meteorito1.reset(499, 100);
      do meteorito2.reset(300, 150);
      do meteorito3.reset(100, 80);
      return;
   }
}