
class Game {
   // game speed (throttling)
   field int delay;
   // objects
   field Player player;
   field Score score;
   field Meteorito meteorito1;
   field Meteorito meteorito2;
   field Meteorito meteorito3;
   field Meteorito meteorito4;
   field Meteorito meteorito5;
   // internal states
   field char key;      
   field char last_key;
   field boolean first_jump;
   field boolean exit;
   field boolean reset;
   field boolean quit;
   // profiling
   field int frames1;
   field int frameCounter;
   field Array info;
   // spikes position for scrolling effect
   field int spikesX;

   constructor Game new(int d) {
      let delay = d;
      // initialize (allocate) objects
      let player = Player.new(8, 128);
      let score = Score.new();
      // create meteoritos starting from the right side of the screen
      // Position them with large spacing so they appear independently, not in groups
      // Max xPos is 491 (since width=20, 491+20=511 is the screen limit)
      // Different baseY values ensure different sprite types for visual variety
      let meteorito1 = Meteorito.new(491, 100);
      let meteorito2 = Meteorito.new(400, 151);
      let meteorito3 = Meteorito.new(300, 80);
      let meteorito4 = Meteorito.new(200, 120);
      let meteorito5 = Meteorito.new(100, 170);
      let frameCounter = 0;
      let spikesX = 0;
      let info = Array.new(6);
      let info[0] = "ET:";
      let info[1] = " (";
      let info[2] = "ms)";
      let info[3] = "  ";
      let info[4] = "Use <> arrow keys to set game speed (delay per frame).";
      let info[5] = "                                                      ";
      return this;
   }

   method void dispose() {
      // dispose of (deallocate) objects
      do player.dispose();
      do score.dispose();
      do meteorito1.dispose();
      do meteorito2.dispose();
      do meteorito3.dispose();
      do meteorito4.dispose();
      do meteorito5.dispose();
      do info.dispose();
      do Memory.deAlloc(this);
      return;
   }

   // handle game logic (keyboard input)
   method void handle_input() {
      let key = Keyboard.keyPressed();
      //
      if (key = 81) { // Q
         let exit = true; 
         let quit = true;
      }
      if ((key = 82) & (~first_jump)) { // R
         let exit = true; 
         let reset = true;
      }
      if ((key = 32) & (~(last_key=32))) { // space
         do player.jump();
         if (first_jump) {
            // first jump (spacebar click) starts the game
            let first_jump = false;
            // clear screen to start playing
            do Screen.clearScreen();
            // Draw spikes at top and bottom (initial position)
            let spikesX = 0;
            do SpriteManager.draw_top_spikes(0);
            do SpriteManager.draw_bottom_spikes(0);
         }
      } else {
         // debug controls: (decrease or increase the time between frames)
         if (((key = 130) & (~(last_key=130))) & (delay > 0)) { let delay = delay - 1; }   // left arrow
         if ((key = 132) & (~(last_key=132))) { let delay = delay + 1; }   // right arrow
      }
      //
      let last_key = key;
      return;
   }


   // update all active objects every frame
   method void refresh() {
      var int playerY;
      var int playerBottom;
      // update player animation
      do player.update();  
      // update the game sprites if started
      if ((~first_jump)) { 
         // Clear spikes areas before updating (top: y=0-10, bottom: y=245-255)
         do Screen.setColor(false);
         do Screen.drawRectangle(0, 0, 512, 11);
         do Screen.drawRectangle(0, 245, 512, 256);
         // Update spikes position (move from right to left, same speed as meteoritos: 2 pixels per frame)
         let spikesX = spikesX - 2;
         // Reset spikes position when they scroll off screen (every 16 pixels, since spike pattern repeats every 16)
         if (spikesX < -16) {
            let spikesX = spikesX + 16;
         }
         // clear previous positions before updating
         do meteorito1.clear();
         do meteorito2.clear();
         do meteorito3.clear();
         do meteorito4.clear();
         do meteorito5.clear();
         // update meteorito positions (move from right to left)
         do meteorito1.update();
         do meteorito2.update();
         do meteorito3.update();
         do meteorito4.update();
         do meteorito5.update();
         // Check if any meteorito exited the screen and increment score
         if (meteorito1.justExited() = 2) {
            do score.increment();
         }
         if (meteorito2.justExited() = 2) {
            do score.increment();
         }
         if (meteorito3.justExited() = 2) {
            do score.increment();
         }
         if (meteorito4.justExited() = 2) {
            do score.increment();
         }
         if (meteorito5.justExited() = 2) {
            do score.increment();
         }
         // draw spikes at new position (scrolling effect)
         do SpriteManager.draw_top_spikes(spikesX);
         do SpriteManager.draw_bottom_spikes(spikesX);
         // draw meteoritos at new positions
         do meteorito1.draw();
         do meteorito2.draw();
         do meteorito3.draw();
         do meteorito4.draw();
         do meteorito5.draw();
         // Update frame counter (score is tracked but not displayed during gameplay)
         let frameCounter = frameCounter + 1;
         // Score will be shown in game over screen, not during gameplay
         // check collisions with meteoritos
         if (meteorito1.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         if (meteorito2.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         if (meteorito3.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         if (meteorito4.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         if (meteorito5.is_colliding(player.hitLeft(), player.hitRight(), player.hitTop(), player.hitBottom()) = 2) {
            let exit = true;
         }
         // check collisions with top and bottom spikes
         // Top spikes: y=0 to y=10
         // Player hitbox top overlaps with top spikes area
         if (player.hitTop() < 10) {
            let exit = true;
         }
         // Bottom spikes: y=245 to y=255
         // Check if player's hitbox overlaps with bottom spikes area
         // Player hitbox: hitTop() = yPos - 2, hitBottom() = yPos + 12
         // Spikes area: y=245 to y=255
         // Player movement limit: yPos < (221-yVel), so max yPos is around 220-221
         // With hitBottom() = yPos + 12, max hitBottom() would be 232-233 (below spikes at y=245)
         // However, visually the player appears to touch spikes when at max position
         // So we need to detect when player is at or near the bottom limit
         let playerY = player.y();
         let playerBottom = player.hitBottom();
         // Primary check: if player's bottom edge reaches or exceeds spike area (y=245)
         if (~(playerBottom < 245)) {
            let exit = true;
         }
         // Secondary check: if player Y position is at or above spike area
         if (~(playerY < 245)) {
            let exit = true;
         }
         // Tertiary check: if player is at maximum downward position (near movement limit)
         // Player max Y is around 220-221, so if yPos >= 218, player is very close to bottom
         // This should trigger collision when player visually appears to touch spikes
         if (playerY > 217) {
            let exit = true;
         }
         // Quaternary check: if player's hitBottom() is close to spikes (within 20 pixels of spike area)
         // Spike area starts at y=245, so if hitBottom() > 225, player is getting close
         // This ensures we catch the collision when player is visually near spikes
         if (playerBottom > 225) {
            let exit = true;
         }
      }
      return;
   }

   // "clock (delay)" printer (profiling tool)
   method void render_vitals() {
         var int safeFrames1;
         var int safeDelay;
         let frames1 = frames1 + 1;
         // Prevent overflow: reset if frames1 becomes too large or negative
         // Max safe value for 16-bit signed int is 32767, reset before reaching it
         if (frames1 > 30000) {
            let frames1 = 0;
         }
         // Only update display every 30 frames to reduce memory usage
         if ((frames1 & 31) = 0) {
            if (frames1 < 0) { 
               let frames1 = 0;
               if (first_jump) {do Output.moveCursor(21,0);} 
               else {do Output.moveCursor(22,0);}
               do Output.printString(info[5]);
            }
            do Output.moveCursor(22,0);
            if (first_jump) {
               do Output.printString(info[4]);
               do Output.moveCursor(21,0);
            }
            // Ensure values are within safe range to prevent ERR6e errors
            if (frames1 < 0) {
               let safeFrames1 = 0;
            } else {
               if (frames1 > 32767) {
                  let safeFrames1 = 32767;
               } else {
                  let safeFrames1 = frames1;
               }
            }
            if (delay < 0) {
               let safeDelay = 0;
            } else {
               if (delay > 32767) {
                  let safeDelay = 32767;
               } else {
                  let safeDelay = delay;
               }
            }
            do Output.printString(info[0]);
            do Output.printInt(safeFrames1);
            do Output.printString(info[1]);
            do Output.printInt(safeDelay);
            do Output.printString(info[2]);
            do Output.printString(info[3]);
         }
      return;
   }

   // Draw large "GAME OVER" text centered on screen with final score
   method void drawGameOver() {
      var int startX;
      var int startY;
      var int letterWidth;
      var int letterHeight;
      var int textWidth;
      var int textHeight;
      var int centerX;
      var int centerY;
      var int finalScore;
      let letterWidth = 30;
      let letterHeight = 40;
      // Calculate text width: 4 letters * 30 + 3 spaces * 10 = 150
      let textWidth = 150;
      // Calculate text height: 40 (line1) + 15 (spacing) + 40 (line2) = 95
      let textHeight = 95;
      // Center horizontally: (512 - 150) / 2 = 181
      let centerX = 181;
      // Center vertically: (256 - 95) / 2 = 80
      let centerY = 80;
      let startX = centerX;
      let startY = centerY;
      do Screen.setColor(true);
      
      // Draw "GAME" - first line
      // G
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY+15, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX+15, startY+20, startX+letterWidth-5, startY+25);
      
      // A (after G, with spacing)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+18, startX+letterWidth, startY+23);
      
      // M (after A)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX+12, startY, startX+18, startY+20);
      do Screen.drawRectangle(startX+letterWidth-18, startY, startX+letterWidth-12, startY+20);
      
      // E (after M)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+17, startX+letterWidth-5, startY+22);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      
      // Draw "OVER" - second line (centered)
      let startX = centerX;
      let startY = startY + letterHeight + 15;
      
      // O
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      
      // V (after O)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight-10);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+letterHeight-10);
      do Screen.drawRectangle(startX+12, startY+letterHeight-15, startX+18, startY+letterHeight);
      
      // E (after V)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+17, startX+letterWidth-5, startY+22);
      do Screen.drawRectangle(startX, startY+letterHeight-5, startX+letterWidth, startY+letterHeight);
      
      // R (after E)
      let startX = startX + letterWidth + 10;
      do Screen.drawRectangle(startX, startY, startX+5, startY+letterHeight);
      do Screen.drawRectangle(startX+letterWidth-5, startY, startX+letterWidth, startY+20);
      do Screen.drawRectangle(startX, startY, startX+letterWidth, startY+5);
      do Screen.drawRectangle(startX, startY+17, startX+letterWidth-5, startY+22);
      do Screen.drawRectangle(startX+letterWidth-8, startY+20, startX+letterWidth-3, startY+letterHeight);
      
      // Draw final score below "GAME OVER"
      // Position: below the "OVER" line, centered horizontally
      // Get final score
      let finalScore = score.value();
      // Position text below "GAME OVER"
      // "GAME" is at centerY = 80, height = 40, so ends at y = 120
      // "OVER" starts at centerY + letterHeight + 15 = 80 + 40 + 15 = 135
      // "OVER" ends at y = 135 + 40 = 175
      // Text rows are approximately 11 pixels tall
      // Row 12 is at y=132 (between GAME and OVER - wrong!)
      // Row 16 is at y=176 (just below OVER)
      // Use row 17 to give some spacing below "OVER"
      // Center horizontally: screen has 64 columns (0-63), "Score: " is 7 chars
      // Assuming score can be up to 5 digits, total is ~12 chars
      // Center position: (64 - 12) / 2 = 26
      do Output.moveCursor(17, 26);
      do Output.printString("Score: ");
      do Output.printInt(finalScore);
      
      return;
   }

   // the main game control
   method boolean run() {
      // init all variables
      let key = 0;
      let last_key = 0;
      let first_jump = true;
      let exit = false;
      let reset = false;
      let quit = false;
      let frames1 = 0;
      let frameCounter = 0;

      // draw the introductory messages (text-only, to keep SpriteManager small)
      do Screen.clearScreen();
      // Draw spikes at top and bottom (initial position)
      do SpriteManager.draw_top_spikes(0);
      do SpriteManager.draw_bottom_spikes(0);
      do Output.moveCursor(5, 10);
      do Output.printString("FLAPPY DINO");
      do Output.moveCursor(7, 10);
      do Output.printString("Press SPACE to start");

      // enter the play loop
      while (~exit) {
         // game logic and render
         do handle_input();
         do refresh();
         // Update frame counter (but don't display during gameplay)
         let frames1 = frames1 + 1;
         // Prevent overflow: reset if frames1 becomes too large
         if (frames1 > 30000) {
            let frames1 = 0;
         }
         do Sys.wait(delay);
      }
      if ((~quit)) { // write "Game Over" if allowed to restart (not quitting)
         // Clear screen and draw large centered "GAME OVER"
         do Screen.clearScreen();
         do drawGameOver();
      }
      // wait to confirm reset, or to quit
      while ((~reset)) {
         let key = Keyboard.keyPressed();
         if (key = 81) { // Q to quit
            return false;
         }
         if (key = 82) { // R to reset
            let reset = true;
         }
      } 
      do reset();  
      return true;
   }

   // recycle already allocated objects upon restart
   method void reset() {
      do Screen.clearScreen();
      // Reset spikes position
      let spikesX = 0;
      // Draw spikes at top and bottom
      do SpriteManager.draw_top_spikes(0);
      do SpriteManager.draw_bottom_spikes(0);
      do player.reset(8, 128);
      do score.reset();
      // reset meteoritos to their initial positions (right side of screen, spaced apart)
      do meteorito1.reset(491, 100);
      do meteorito2.reset(400, 151);
      do meteorito3.reset(300, 80);
      do meteorito4.reset(200, 120);
      do meteorito5.reset(100, 170);
      return;
   }
}