
class Meteorito {
   field int xPos;
   field int yPos;
   field int width;
   field int height;
   field int speed;
   field int lastX;
   field int baseY;
   field int spriteType; // 0 para meteorito1, 1 para meteorito2 
   field boolean justExitedScreen; // true si el meteorito sale del lado izquierdo

   constructor Meteorito new(int x, int y) {
      do reset(x, y);
      return this;
   }

   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   method void draw() {
      // dibujar si esta en una posicion "valida" (con espacio suficiente)
      if ((~(xPos < 0)) & (~((xPos + 20) > 511))) {
         if ((~(yPos < 0)) & (~((yPos + 20) > 255))) {
            // Alternate between two sprite types for visual variety
            if (spriteType = 0) {
               do SpriteManager.draw_meteorito(xPos, yPos);
            } else {
               do SpriteManager.draw_meteorito2(xPos, yPos);
            }
         }
      }
      return;
   }

   method void clear() {
      // clear donde estaba el meteorito
      if ((~(lastX < 0)) & (~((lastX + 20) > 511))) {
         if ((~(yPos < 0)) & (~((yPos + 20) > 255))) {
            do SpriteManager.clear_meteorito(lastX, yPos);
         }
      }
      return;
   }

   // ver si el jugador de choca
   method int is_colliding(int playerLeft, int playerRight, int playerTop, int playerBottom) {
      // la hitbox es 2 pixeles mas grande que la sprite
      var int expandedLeft;
      var int expandedRight;
      var int expandedTop;
      var int expandedBottom;
      let expandedLeft = xPos - 2;
      let expandedRight = xPos + width + 2;
      let expandedTop = yPos - 2;
      let expandedBottom = yPos + height + 2;
      // ver si la hitbox del meteorito hace overlap con la del jugador
      if ((playerRight > expandedLeft) & (playerLeft < expandedRight)) {
         if ((playerBottom > expandedTop) & (playerTop < expandedBottom)) {
            return 2; // collision
         }
      }
      return 0; // no collision
   }

   method int x() {
      return xPos;
   }

   method int y() {
      return yPos;
   }

   method int w() {
      return width;
   }

   method int h() {
      return height;
   }

   method void reset(int x, int y) {
      let xPos = x;
      let yPos = y;
      let baseY = y;
      let width = 20;  // Updated to match doubled sprite size (x+2 to x+20)
      let height = 20; // Updated to match doubled sprite size (y+2 to y+20)
      let speed = 2;
      let lastX = x;
      let justExitedScreen = false;
      // basey determina que sprite spawnea
      let spriteType = baseY & 1;
      return;
   }

   method void setPosition(int x, int y) {
      let xPos = x;
      let yPos = y;
      return;
   }

   // ver si el meteorito sale de la pantalla por la izquierda
   method int justExited() {
      if (justExitedScreen) {
         let justExitedScreen = false; // Reset flag after checking
         return 2;
      }
      return 0;
   }

   method void update() {
      var int offsetX;
      var int yVariation;
      var int yOffset;
      var int safeBaseY;
      let lastX = xPos;
      // mover el meteorito
      let xPos = xPos - speed;
      // si el meteorito sale por la izquierda poner uno en la derecha
      if ((xPos + width) < 0) {
         let justExitedScreen = true;
         // variar movimientos en x
         let offsetX = baseY & 63; // Offset 0-63 pixels (safer than multiplication)
         let xPos = 491 - offsetX; // Start from right, with variation (491+20=511)
         // x no este en negativo
         if (xPos < 0) {
            let xPos = 0;
         }
         if ((xPos + width) > 511) {
            let xPos = 491;
         }
         let lastX = xPos; 
         // alternar sprites
         if (spriteType = 0) {
            let spriteType = 1;
         } else {
            let spriteType = 0;
         }
         // variar y
         if (baseY > 255) {
            let safeBaseY = 255;
         } else {
            if (baseY < 0) {
               let safeBaseY = 0;
            } else {
               let safeBaseY = baseY;
            }
         }

         let yVariation = safeBaseY & 7; // crear variacion
         if (yVariation > 5) {
            let yOffset = 15;
         } else {
            if (yVariation > 3) {
               let yOffset = 5;
            } else {
               if (yVariation > 1) {
                  let yOffset = -5;
               } else {
                  let yOffset = -15;
               }
            }
         }
         let yPos = safeBaseY + yOffset; // Vary around safeBaseY
         // y pos esta en los rangos
         if (yPos > 235) {
            let yPos = 235;
         }
         if (yPos < 0) {
            let yPos = 0;
         }
      }
      return;
   }
}

