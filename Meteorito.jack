
class Meteorito {
   field int xPos;
   field int yPos;
   field int width;
   field int height;
   field int speed;
   field int lastX;
   field int baseY;
   field int spriteType; // 0 for meteorito1, 1 for meteorito2
   field boolean justExitedScreen; // true if meteorito just exited left side

   constructor Meteorito new(int x, int y) {
      do reset(x, y);
      return this;
   }

   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   method void draw() {
      // Only draw if position is within valid screen bounds (0-511 for x, 0-255 for y)
      // Sprite is 20x20, so xPos + 20 must be <= 511, meaning xPos <= 491
      // Using ~(x < 0) for x >= 0, and ~((xPos + 20) > 511) for (xPos + 20) <= 511
      if ((~(xPos < 0)) & (~((xPos + 20) > 511))) {
         if ((~(yPos < 0)) & (~((yPos + 20) > 255))) {
            // Alternate between two sprite types for visual variety
            if (spriteType = 0) {
               do SpriteManager.draw_meteorito(xPos, yPos);
            } else {
               do SpriteManager.draw_meteorito2(xPos, yPos);
            }
         }
      }
      return;
   }

   method void clear() {
      // Clear the area where meteorito was drawn (at last position)
      // Only clear if lastX is within valid screen bounds
      // Sprite is 20x20, so lastX + 20 must be <= 511
      // Using ~(x < 0) for x >= 0, and ~((lastX + 20) > 511) for (lastX + 20) <= 511
      if ((~(lastX < 0)) & (~((lastX + 20) > 511))) {
         if ((~(yPos < 0)) & (~((yPos + 20) > 255))) {
            do SpriteManager.clear_meteorito(lastX, yPos);
         }
      }
      return;
   }

   // Check collision with player rectangle
   // Returns: 2 = collision, 0 = no collision
   // Increased hitbox for better collision detection
   method int is_colliding(int playerLeft, int playerRight, int playerTop, int playerBottom) {
      // Expanded meteorito hitbox by 2 pixels on each side for better detection
      var int expandedLeft;
      var int expandedRight;
      var int expandedTop;
      var int expandedBottom;
      let expandedLeft = xPos - 2;
      let expandedRight = xPos + width + 2;
      let expandedTop = yPos - 2;
      let expandedBottom = yPos + height + 2;
      // Check if player rectangle overlaps with expanded meteorito rectangle
      if ((playerRight > expandedLeft) & (playerLeft < expandedRight)) {
         if ((playerBottom > expandedTop) & (playerTop < expandedBottom)) {
            return 2; // collision
         }
      }
      return 0; // no collision
   }

   method int x() {
      return xPos;
   }

   method int y() {
      return yPos;
   }

   method int w() {
      return width;
   }

   method int h() {
      return height;
   }

   method void reset(int x, int y) {
      let xPos = x;
      let yPos = y;
      let baseY = y;
      let width = 20;  // Updated to match doubled sprite size (x+2 to x+20)
      let height = 20; // Updated to match doubled sprite size (y+2 to y+20)
      let speed = 2;
      let lastX = x;
      let justExitedScreen = false;
      // Use baseY to determine sprite type for variety (0 or 1)
      let spriteType = baseY & 1;
      return;
   }

   method void setPosition(int x, int y) {
      let xPos = x;
      let yPos = y;
      return;
   }

   // Check if meteorito just exited the left side of the screen
   // Returns: 2 if meteorito just exited, 0 otherwise
   method int justExited() {
      if (justExitedScreen) {
         let justExitedScreen = false; // Reset flag after checking
         return 2;
      }
      return 0;
   }

   method void update() {
      var int offsetX;
      var int yVariation;
      var int yOffset;
      var int safeBaseY;
      // Remember last position before moving
      let lastX = xPos;
      // Move meteorito from right to left
      let xPos = xPos - speed;
      // If meteorito goes off the left side, reset it to the right side
      // Make sure xPos + width doesn't exceed screen width (max 511)
      // Screen is 512 pixels wide (0-511), so max xPos is 491 (491+20=511)
      if ((xPos + width) < 0) {
         // Mark that this meteorito just exited the screen
         let justExitedScreen = true;
         // Vary X position based on baseY to space out meteoritos
         // Each meteorito gets a different starting X based on its baseY
         // This creates independent appearance patterns
         // Use simpler calculation to avoid arithmetic errors
         let offsetX = baseY & 63; // Offset 0-63 pixels (safer than multiplication)
         let xPos = 491 - offsetX; // Start from right, with variation (491+20=511)
         // Ensure xPos doesn't go below 0
         if (xPos < 0) {
            let xPos = 0;
         }
         // Ensure xPos + width doesn't exceed 511
         if ((xPos + width) > 511) {
            let xPos = 491;
         }
         let lastX = xPos; // Also update lastX to avoid clearing at negative position
         // Alternate sprite type when repositioning for visual variety
         if (spriteType = 0) {
            let spriteType = 1;
         } else {
            let spriteType = 0;
         }
         // Vary the Y position based on baseY to create independent patterns
         // Use only baseY to avoid any arithmetic that could cause overflow
         // Limit baseY to safe range first
         if (baseY > 255) {
            let safeBaseY = 255;
         } else {
            if (baseY < 0) {
               let safeBaseY = 0;
            } else {
               let safeBaseY = baseY;
            }
         }
         // Use only safeBaseY for variation, no addition with xPos
         let yVariation = safeBaseY & 7; // Create variation: 0-7 range (very safe, no addition)
         // Map yVariation to offset range using simple if-else
         if (yVariation > 5) {
            let yOffset = 15;
         } else {
            if (yVariation > 3) {
               let yOffset = 5;
            } else {
               if (yVariation > 1) {
                  let yOffset = -5;
               } else {
                  let yOffset = -15;
               }
            }
         }
         let yPos = safeBaseY + yOffset; // Vary around safeBaseY
         // Ensure yPos stays within screen bounds (0-255, considering height=20, max yPos=235)
         if (yPos > 235) {
            let yPos = 235;
         }
         if (yPos < 0) {
            let yPos = 0;
         }
      }
      return;
   }
}

