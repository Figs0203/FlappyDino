
class Meteorito {
   field int xPos;
   field int yPos;
   field int width;
   field int height;
   field int speed;
   field int lastX;
   field int baseY;

   constructor Meteorito new(int x, int y) {
      do reset(x, y);
      return this;
   }

   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   method void draw() {
      // Only draw if position is within valid screen bounds (0-511 for x, 0-255 for y)
      // xPos + width must be <= 511, so xPos <= 499 (since width = 12)
      // Using ~(x < 0) for x >= 0, and ~((xPos + width) > 511) for (xPos + width) <= 511
      if ((~(xPos < 0)) & (~((xPos + width) > 511))) {
         if ((~(yPos < 0)) & (~((yPos + height) > 255))) {
      do Screen.setColor(true);
      // Main body (circular approximation)
      do Screen.drawRectangle(xPos, yPos, xPos+width, yPos+height);
      // Add some detail to make it look more like a meteor
      do Screen.drawRectangle(xPos+2, yPos+2, xPos+width-2, yPos+height-2);
         }
      }
      return;
   }

   method void clear() {
      // Clear the area where meteorito was drawn (at last position)
      // Only clear if lastX is within valid screen bounds
      // Using ~(x < 0) for x >= 0, and ~((lastX + width) > 511) for (lastX + width) <= 511
      if ((~(lastX < 0)) & (~((lastX + width) > 511))) {
         if ((~(yPos < 0)) & (~((yPos + height) > 255))) {
      do Screen.setColor(false);
            do Screen.drawRectangle(lastX, yPos, lastX+width, yPos+height);
         }
      }
      return;
   }

   // Check collision with player rectangle
   // Returns: 2 = collision, 0 = no collision
   method int is_colliding(int playerLeft, int playerRight, int playerTop, int playerBottom) {
      // Check if player rectangle overlaps with meteorito rectangle
      if ((playerRight > xPos) & (playerLeft < (xPos+width))) {
         if ((playerBottom > yPos) & (playerTop < (yPos+height))) {
            return 2; // collision
         }
      }
      return 0; // no collision
   }

   method int x() {
      return xPos;
   }

   method int y() {
      return yPos;
   }

   method int w() {
      return width;
   }

   method int h() {
      return height;
   }

   method void reset(int x, int y) {
      let xPos = x;
      let yPos = y;
      let baseY = y;
      let width = 12;
      let height = 12;
      let speed = 2;
      let lastX = x;
      return;
   }

   method void setPosition(int x, int y) {
      let xPos = x;
      let yPos = y;
      return;
   }

   method void update() {
      var int offsetX;
      var int yVariation;
      var int yOffset;
      var int safeBaseY;
      // Remember last position before moving
      let lastX = xPos;
      // Move meteorito from right to left
      let xPos = xPos - speed;
      // If meteorito goes off the left side, reset it to the right side
      // Make sure xPos + width doesn't exceed screen width (max 511)
      // Screen is 512 pixels wide (0-511), so max xPos is 499 (499+12=511)
      if ((xPos + width) < 0) {
         // Vary X position based on baseY to space out meteoritos
         // Each meteorito gets a different starting X based on its baseY
         // This creates independent appearance patterns
         // Use simpler calculation to avoid arithmetic errors
         let offsetX = baseY & 63; // Offset 0-63 pixels (safer than multiplication)
         let xPos = 499 - offsetX; // Start from right, with variation
         // Ensure xPos doesn't go below 0
         if (xPos < 0) {
            let xPos = 0;
         }
         // Ensure xPos + width doesn't exceed 511
         if ((xPos + width) > 511) {
            let xPos = 499;
         }
         let lastX = xPos; // Also update lastX to avoid clearing at negative position
         // Vary the Y position based on baseY to create independent patterns
         // Use only baseY to avoid any arithmetic that could cause overflow
         // Limit baseY to safe range first
         if (baseY > 255) {
            let safeBaseY = 255;
         } else {
            if (baseY < 0) {
               let safeBaseY = 0;
            } else {
               let safeBaseY = baseY;
            }
         }
         // Use only safeBaseY for variation, no addition with xPos
         let yVariation = safeBaseY & 7; // Create variation: 0-7 range (very safe, no addition)
         // Map yVariation to offset range using simple if-else
         if (yVariation > 5) {
            let yOffset = 15;
         } else {
            if (yVariation > 3) {
               let yOffset = 5;
            } else {
               if (yVariation > 1) {
                  let yOffset = -5;
               } else {
                  let yOffset = -15;
               }
            }
         }
         let yPos = safeBaseY + yOffset; // Vary around safeBaseY
         // Ensure yPos stays within screen bounds (0-255, considering height=12, max yPos=243)
         if (yPos > 243) {
            let yPos = 243;
         }
         if (yPos < 0) {
            let yPos = 0;
         }
      }
      return;
   }
}

