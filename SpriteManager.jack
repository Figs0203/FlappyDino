class SpriteManager {

   // Very small placeholder sprites for the pterodactyl, drawn with Screen API
   // to keep this file tiny and avoid running out of memory in the web IDE.
   // We also provide a clear function to erase the previous sprite position.

   function void clear_pterodactilobw(int x, int y) {
      // Clear the bounding box where the pterodactyl was previously drawn.
      // Updated bounds to cover both detailed pixelart sprites:
      // - draw_pterodactilobw: x+4 to x+27, y+6 to y+21
      // - draw_pterodactilobw2: x+4 to x+27, y+3 to y+16
      // Using the union of both bounding boxes to ensure no black trails.
      do Screen.setColor(false);
      do Screen.drawRectangle(x+4, y+3, x+28, y+22);
      return;
   }

