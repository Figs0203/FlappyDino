            do Screen.drawRectangle(x+18, y+6, x+20, y+8);

            do Screen.drawRectangle(x+2, y+8, x+4, y+10);
            do Screen.drawRectangle(x+12, y+8, x+14, y+10);
            do Screen.drawRectangle(x+14, y+8, x+16, y+10);
            do Screen.drawRectangle(x+18, y+8, x+20, y+10);

            do Screen.drawRectangle(x+2, y+10, x+4, y+12);
            do Screen.drawRectangle(x+12, y+10, x+14, y+12);
            do Screen.drawRectangle(x+18, y+10, x+20, y+12);

            do Screen.drawRectangle(x+2, y+12, x+4, y+14);
            do Screen.drawRectangle(x+4, y+12, x+6, y+14);
            do Screen.drawRectangle(x+8, y+12, x+10, y+14);
            do Screen.drawRectangle(x+12, y+12, x+14, y+14);
            do Screen.drawRectangle(x+14, y+12, x+16, y+14);
            do Screen.drawRectangle(x+18, y+12, x+20, y+14);

            do Screen.drawRectangle(x+2, y+14, x+4, y+16);
            do Screen.drawRectangle(x+4, y+14, x+6, y+16);
            do Screen.drawRectangle(x+6, y+14, x+8, y+16);
            do Screen.drawRectangle(x+8, y+14, x+10, y+16);
            do Screen.drawRectangle(x+10, y+14, x+12, y+16);
            do Screen.drawRectangle(x+14, y+14, x+16, y+16);
            do Screen.drawRectangle(x+16, y+14, x+18, y+16);
            do Screen.drawRectangle(x+18, y+14, x+20, y+16);

            do Screen.drawRectangle(x+4, y+16, x+6, y+18);
            do Screen.drawRectangle(x+6, y+16, x+8, y+18);
            do Screen.drawRectangle(x+12, y+16, x+14, y+18);
            do Screen.drawRectangle(x+14, y+16, x+16, y+18);
            do Screen.drawRectangle(x+16, y+16, x+18, y+18);

            do Screen.drawRectangle(x+6, y+18, x+8, y+20);
            do Screen.drawRectangle(x+8, y+18, x+10, y+20);
            do Screen.drawRectangle(x+10, y+18, x+12, y+20);
            do Screen.drawRectangle(x+12, y+18, x+14, y+20);
            do Screen.drawRectangle(x+14, y+18, x+16, y+20);
         }
      }
      return;
   }

   // pinchos arriba
   function void draw_top_spikes(int offsetX) {
      var int x;
      var int spikeHeight;
      var int startX;
      var int patternX;
      let spikeHeight = 10;
      do Screen.setColor(true);
      let startX = offsetX;
      while (startX < 0) {
         let startX = startX + 16;
      }
      while (startX > 15) {
         let startX = startX - 16;
      }
      let x = startX - 16;
      while (x < 512) {
         let patternX = x;
         while (patternX < 0) {
            let patternX = patternX + 16;
         }
         while (patternX > 15) {
            let patternX = patternX - 16;
         }
         if ((~(x < 0)) & (~(x > 511))) {
            if ((x + 16) > 511) {
               do Screen.drawRectangle(x, 0, 512, 1);
            } else {
               do Screen.drawRectangle(x, 0, x + 16, 1);
            }
            if ((x + 1) < 512) {
               if ((x + 15) > 511) {
                  do Screen.drawRectangle(x + 1, 1, 512, 2);
               } else {
                  do Screen.drawRectangle(x + 1, 1, x + 15, 2);
               }
            }
            if ((x + 2) < 512) {
               if ((x + 14) > 511) {
                  do Screen.drawRectangle(x + 2, 2, 512, 3);
               } else {
                  do Screen.drawRectangle(x + 2, 2, x + 14, 3);
               }
            }
            if ((x + 3) < 512) {
               if ((x + 13) > 511) {
                  do Screen.drawRectangle(x + 3, 3, 512, 4);
               } else {
                  do Screen.drawRectangle(x + 3, 3, x + 13, 4);
               }
            }
            if ((x + 4) < 512) {
               if ((x + 12) > 511) {
                  do Screen.drawRectangle(x + 4, 4, 512, 5);
               } else {
                  do Screen.drawRectangle(x + 4, 4, x + 12, 5);
               }
            }
            if ((x + 5) < 512) {
               if ((x + 11) > 511) {
                  do Screen.drawRectangle(x + 5, 5, 512, 6);
               } else {
                  do Screen.drawRectangle(x + 5, 5, x + 11, 6);
               }
            }
            if ((x + 6) < 512) {
               if ((x + 10) > 511) {
                  do Screen.drawRectangle(x + 6, 6, 512, 7);
               } else {
                  do Screen.drawRectangle(x + 6, 6, x + 10, 7);
               }
            }
            if ((x + 7) < 512) {
               if ((x + 9) > 511) {
                  do Screen.drawRectangle(x + 7, 7, 512, 8);
               } else {
                  do Screen.drawRectangle(x + 7, 7, x + 9, 8);
               }
            }
            if ((x + 7) < 512) {
               if ((x + 9) > 511) {
                  do Screen.drawRectangle(x + 7, 8, 512, 9);
               } else {
                  do Screen.drawRectangle(x + 7, 8, x + 9, 9);
               }
            }
            if ((x + 7) < 512) {
               if ((x + 9) > 511) {
                  do Screen.drawRectangle(x + 7, 9, 512, 10);
               } else {
                  do Screen.drawRectangle(x + 7, 9, x + 9, 10);
               }
            }
         }
         let x = x + 16;
      }
      return;
   }

   // pinchos abajo
   function void draw_bottom_spikes(int offsetX) {
      var int x;
      var int bottomY;
      var int spikeHeight;
      var int startX;
      var int patternX;
      let spikeHeight = 10;
      let bottomY = 255;
      do Screen.setColor(true);
      let startX = offsetX;
      while (startX < 0) {
         let startX = startX + 16;
      }
      while (startX > 15) {
         let startX = startX - 16;
      }
      let x = startX - 16;
      while (x < 512) {
         let patternX = x;
         while (patternX < 0) {
            let patternX = patternX + 16;
         }
         while (patternX > 15) {
            let patternX = patternX - 16;
         }
         if ((~(x < 0)) & (~(x > 511))) {
            // Row 0 (point at top)
            if ((x + 7) < 512) {
               if ((x + 9) > 511) {
                  do Screen.drawRectangle(x + 7, bottomY - 9, 512, bottomY - 8);
               } else {
                  do Screen.drawRectangle(x + 7, bottomY - 9, x + 9, bottomY - 8);
               }
            }
            if ((x + 7) < 512) {
               if ((x + 9) > 511) {
                  do Screen.drawRectangle(x + 7, bottomY - 8, 512, bottomY - 7);
               } else {
                  do Screen.drawRectangle(x + 7, bottomY - 8, x + 9, bottomY - 7);
               }
            }
            if ((x + 6) < 512) {
               if ((x + 10) > 511) {
                  do Screen.drawRectangle(x + 6, bottomY - 7, 512, bottomY - 6);
               } else {
                  do Screen.drawRectangle(x + 6, bottomY - 7, x + 10, bottomY - 6);
               }
            }
            if ((x + 5) < 512) {
               if ((x + 11) > 511) {
                  do Screen.drawRectangle(x + 5, bottomY - 6, 512, bottomY - 5);
               } else {
                  do Screen.drawRectangle(x + 5, bottomY - 6, x + 11, bottomY - 5);
               }
            }
            if ((x + 4) < 512) {
               if ((x + 12) > 511) {
                  do Screen.drawRectangle(x + 4, bottomY - 5, 512, bottomY - 4);
               } else {
                  do Screen.drawRectangle(x + 4, bottomY - 5, x + 12, bottomY - 4);
               }
            }
            if ((x + 3) < 512) {
               if ((x + 13) > 511) {
                  do Screen.drawRectangle(x + 3, bottomY - 4, 512, bottomY - 3);
               } else {
                  do Screen.drawRectangle(x + 3, bottomY - 4, x + 13, bottomY - 3);
               }
            }
            if ((x + 2) < 512) {
               if ((x + 14) > 511) {
                  do Screen.drawRectangle(x + 2, bottomY - 3, 512, bottomY - 2);
               } else {
                  do Screen.drawRectangle(x + 2, bottomY - 3, x + 14, bottomY - 2);
               }
            }
            if ((x + 1) < 512) {
               if ((x + 15) > 511) {
                  do Screen.drawRectangle(x + 1, bottomY - 2, 512, bottomY - 1);
               } else {
                  do Screen.drawRectangle(x + 1, bottomY - 2, x + 15, bottomY - 1);
               }
            }
            if (x < 512) {
               if ((x + 16) > 511) {
                  do Screen.drawRectangle(x, bottomY - 1, 512, bottomY);
               } else {
                  do Screen.drawRectangle(x, bottomY - 1, x + 16, bottomY);
               }
            }
            if (x < 512) {
               if ((x + 16) > 511) {
                  do Screen.drawRectangle(x, bottomY, 512, 256);
               } else {
                  do Screen.drawRectangle(x, bottomY, x + 16, 256);
               }
            }
         }
         let x = x + 16;
      }
      return;
   }

}



