      // meteorito clear donde estaba antes
   function void clear_meteorito(int x, int y) {
      if ((~(x < 0)) & (~((x + 22) > 512))) {
         if ((~(y < 0)) & (~((y + 22) > 256))) {
            do Screen.setColor(false);
            do Screen.drawRectangle(x+2, y+2, x+22, y+22);
         }
      }
      return;
   }
      // meteorito sprite 1
   function void draw_meteorito(int x, int y) {
      if ((~(x < 0)) & (~((x + 22) > 512))) {
         if ((~(y < 0)) & (~((y + 22) > 256))) {
            do Screen.setColor(true);

            do Screen.drawRectangle(x+6, y+2, x+8, y+4);
            do Screen.drawRectangle(x+8, y+2, x+10, y+4);
            do Screen.drawRectangle(x+10, y+2, x+12, y+4);
            do Screen.drawRectangle(x+12, y+2, x+14, y+4);
            do Screen.drawRectangle(x+14, y+2, x+16, y+4);

            do Screen.drawRectangle(x+4, y+4, x+6, y+6);
