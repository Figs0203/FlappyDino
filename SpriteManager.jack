            do Screen.drawRectangle(x+14, y+2, x+16, y+4);

            do Screen.drawRectangle(x+4, y+4, x+6, y+6);
            do Screen.drawRectangle(x+6, y+4, x+8, y+6);
            do Screen.drawRectangle(x+12, y+4, x+14, y+6);
